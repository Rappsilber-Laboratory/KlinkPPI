{
  "name": "klinkppi-workspace",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/setup.mjs",
    "setup": "node scripts/setup.mjs",
    "build": "node scripts/setup.mjs && npm --prefix frontend run build",
    "dev": "node scripts/dev.mjs",
    "start": "npm run dev",
    "serve": "node scripts/serve.mjs",
    "prepare-server": "node -e \"require('child_process').spawnSync(process.platform==='win32'?'.venv/Scripts/python.exe':'.venv/bin/python',['scripts/prepare_server.py',...process.argv.slice(1)],{stdio:'inherit'})\""
  }
}
